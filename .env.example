# --- Required tokens (no default in code) -----------------------------------
# Under enrollment (§6) there is NO shared /ext token: an instance authenticates by a
# per-install secret it generates during enrollment. /mcp takes ADMIN_TOKEN; /api/* takes
# ADMIN_TOKEN or an ACTIVE instance's own secret. That secret travels RAW over TLS (on
# /ext hello and as the /api Bearer alike) and the SERVER hashes it on receipt — only the
# sha256 is ever stored, so a client never sends, and an operator never configures, a
# hash. Only TWO tokens are configured here.
# METRICS_TOKEN is read-only for /metrics; ADMIN_TOKEN opens /admin (the enrollment
# console, §10), /api/* (as the human/agent caller) and /mcp. Both are required, empty =
# startup failure (§4). They must DIFFER (§12): the metrics token lives in a plaintext
# scrape config in git, so reusing it as ADMIN_TOKEN would publish /admin, /api/* and
# /mcp access in that same file. Equal values = startup failure.
#   MIGRATION NOTE: the former shared /ext token is GONE. After upgrading, every existing
#   MAIN and instance must RE-ENROLL (open a window on /admin, take the code, approve) —
#   the old shared token no longer authenticates anything.
METRICS_TOKEN=
ADMIN_TOKEN=
# ADMIN_SESSION_TTL_MIN=720       # lifetime of an /admin HTML-console login session
#                                 # (§10, "Консоль /admin"). The cookie holds a random id,
#                                 # never ADMIN_TOKEN; validity is checked server-side in an
#                                 # in-memory store and a rotated ADMIN_TOKEN kills all
#                                 # sessions. 720 = 12h.

# --- Logging / infra --------------------------------------------------------
LOG_LEVEL=INFO
# DB_PATH=data/curator.db
# BACKUP_DIR=data/backups          # dev default (under data/). In prod it is the same
#                                  # single volume as the DB, one level down:
#                                  # BACKUP_DIR=/app/data/backups (see docker-compose.yml).
#                                  # The copies therefore share free space with the DB —
#                                  # `curator-backup-stale` (deploy/alerts.yml) is what
#                                  # tells you the nightly copy stopped landing.
# HOST=0.0.0.0
# PORT=8000
# RESTORE_MARKER_PATH=             # EXTERNAL restore-from-backup marker (§7). EMPTY =
#                                  # detection off. "Off" is itself a RECORDED state, not
#                                  # the absence of one: staying off forever costs
#                                  # nothing, but TURNING DETECTION ON OR OFF LATER is a
#                                  # continuity break like any other config change — see
#                                  # the CONFIG CHANGE note at the end of this block.
#                                  # A DB restored from backup carries the backup's own
#                                  # db_uuid, so restore can only be detected from
#                                  # OUTSIDE the DB. Point this at a small file that is
#                                  # neither the DB nor part of a backup copy — the
#                                  # shipped docker-compose.yml sets exactly that:
#                                  #   RESTORE_MARKER_PATH=/app/data/restore/continuity-marker
#                                  # Same volume as the DB (one volume holds all mutable
#                                  # state), but its own file: the documented restore
#                                  # procedure puts back the DB FILE, so the marker
#                                  # survives it. Rolling back the whole VOLUME (a storage
#                                  # snapshot) rolls the marker back too and is NOT
#                                  # detectable — deploy/DEPLOY.md §5 spells out that cost.
#                                  # In the container the marker is created automatically:
#                                  # the entrypoint writes a fresh uuid on the first start
#                                  # if the file is absent and NEVER rewrites an existing
#                                  # one. Outside the container, create it once by hand:
#                                  #   uuidgen > "$RESTORE_MARKER_PATH"
#                                  # After EVERY restore the operator writes a NEW value
#                                  # into it — that step is manual on purpose and cannot be
#                                  # automated: the service cannot know it was rolled back.
#                                  # A changed marker = continuity break => the first
#                                  # pass is dry_run and waits for a confirming click.
#                                  # Restore procedure: deploy/DEPLOY.md.
#                                  # UPGRADE NOTE: the shipped compose file now sets this
#                                  # unconditionally. Upgrading an EXISTING install does
#                                  # NOT cause a false break — a fingerprint written
#                                  # before this release carries no marker component, so
#                                  # the first pass skips that comparison and records the
#                                  # digest; from the next pass on it is compared. The
#                                  # cost is one blind pass: a restore performed between
#                                  # the upgrade and that first pass is not caught BY THE
#                                  # MARKER (the other fingerprint components still are).
#                                  # CONFIG CHANGE NOTE: switching detection ON (empty ->
#                                  # a path) or OFF (a path -> empty) on an install that
#                                  # has already run a pass under this release is a
#                                  # continuity break, EXPECTED and one-off: the next pass
#                                  # is a dry_run, the plan is shown, one click resumes
#                                  # normal operation. This is deliberate — the fingerprint
#                                  # treats its config inputs alike (IDLE_MINUTES and
#                                  # MAIN_INSTANCE_ID behave the same, §7), and a SILENT
#                                  # switch-off would drop restore detection with no signal
#                                  # at all. Plan the toggle for a maintenance window.
#                                  # WHAT COUNTS AS A BREAK: a CHANGE of state, in either
#                                  # direction — content rewritten, a file that was there
#                                  # disappearing, or a file APPEARING over a recorded
#                                  # "absent". A file that stays absent pass after pass is
#                                  # NOT a break (it is the same state as last time), and
#                                  # a read that FAILS (volume not mounted yet, wrong
#                                  # permissions) is never a break — it is treated as "no
#                                  # information", the stored digest is kept, and
#                                  # /metrics reports curator_restore_marker_unreadable=1
#                                  # so a permanently blind detector is visible. If that
#                                  # gauge is 1, restore detection is OFF: check that the
#                                  # file is readable by uid 1000 (the container user).

# --- §4 tunables (defaults live in code; uncomment to override) -------------
# IDLE_MINUTES=60
# PASS_INTERVAL_MIN=5
# TICK_MS=60000
# HEARTBEAT_MS=15000
# CMD_TIMEOUT_MS=20000
# SNAPSHOT_TIMEOUT_MS=10000
# LEASE_TTL_MS=600000
# RESTORE_EXEMPTION_MIN=120
# PAUSE_DEFAULT_MIN=60
# INCOMPLETE_AFTER_MIN=15
# SELF_NAV_LIMIT=10
# STATE_FRESH_MS=3000
# QUARANTINE_TTL_MIN=1440
# ACTIONS_RETENTION_DAYS=90
# JS_AUDIT_RETENTION_DAYS=730
# MAIN_INSTANCE_ID=main
# PROTOCOL_VERSION=1
# ENROLL_WINDOW_MIN=10            # enrollment window length in minutes (§6). Compared
#                                 # against "now" at read time (no timer), so a restart
#                                 # neither closes an armed window early nor keeps it open.
# ENROLL_MAX_PENDING=64           # ceiling on PENDING enroll_requests (§6). An
#                                 # enroll_request is refused with reason=capacity once
#                                 # the pending list is this large, bounding the
#                                 # operator-facing list against an anon flood. The refusal
#                                 # is counted under the label enroll_capacity (NOT the
#                                 # /ext-socket "capacity" of ENROLL_PREAUTH_MAX below) and
#                                 # alerted by curator-enroll-pending-capacity (§12).
# ENROLL_REQUEST_TTL_MIN=60       # lifetime of a PENDING enroll_request (§6). Filtered
#                                 # out of GET /admin/enroll/requests once first_seen_at is
#                                 # older than this, then physically swept within ~60s.
#                                 # Must be >= ENROLL_WINDOW_MIN (equality is allowed and
#                                 # reachable: ENROLL_WINDOW_MIN=60, its ceiling, against
#                                 # this default of 60) so an operator always has a live
#                                 # request to approve; startup FAILS if it is smaller.
#                                 # Bounded so a stale/abandoned request self-clears
#                                 # instead of lingering forever.
# ENROLL_PREAUTH_MAX=128          # ceiling on accepted /ext sockets that have not yet
#                                 # said hello/enroll (§6). The Nth pre-auth socket is
#                                 # refused BEFORE accept() (a handshake rejection, no TLS
#                                 # session). A successful hello releases its slot, so this
#                                 # bounds only the pre-auth window, not the live fleet.
