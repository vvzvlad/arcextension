# --- Required tokens (no default in code) -----------------------------------
# Under enrollment (§6) there is NO shared /ext token: an instance authenticates by a
# per-install secret it generates during enrollment. /mcp takes ADMIN_TOKEN; /api/* takes
# ADMIN_TOKEN or an ACTIVE instance's own secret. That secret travels RAW over TLS (on
# /ext hello and as the /api Bearer alike) and the SERVER hashes it on receipt — only the
# sha256 is ever stored, so a client never sends, and an operator never configures, a
# hash. Only TWO tokens are configured here.
# METRICS_TOKEN is read-only for /metrics; ADMIN_TOKEN opens /admin (the enrollment
# console, §10), /api/* (as the human/agent caller) and /mcp. Both are required, empty =
# startup failure (§4). They must DIFFER (§12): the metrics token lives in a plaintext
# scrape config in git, so reusing it as ADMIN_TOKEN would publish /admin, /api/* and
# /mcp access in that same file. Equal values = startup failure.
#   MIGRATION NOTE: the former shared /ext token is GONE. After upgrading, every existing
#   MAIN and instance must RE-ENROLL (open a window on /admin, take the code, type it in
#   the browser) — the old shared token no longer authenticates anything.
METRICS_TOKEN=
ADMIN_TOKEN=
# ADMIN_SESSION_TTL_MIN=720       # lifetime of an /admin HTML-console login session
#                                 # (§10, "Консоль /admin"). The cookie holds a random id,
#                                 # never ADMIN_TOKEN; validity is checked server-side in an
#                                 # in-memory store and a rotated ADMIN_TOKEN kills all
#                                 # sessions. 720 = 12h.

# --- Logging / infra --------------------------------------------------------
LOG_LEVEL=INFO
# DB_PATH=data/curator.db
# BACKUP_DIR=data/backups          # dev default (under data/). In prod it is the same
#                                  # single volume as the DB, one level down:
#                                  # BACKUP_DIR=/app/data/backups (see docker-compose.yml).
#                                  # The copies therefore share free space with the DB —
#                                  # `curator-backup-stale` (deploy/alerts.yml) is what
#                                  # tells you the nightly copy stopped landing.
# HOST=0.0.0.0
# PORT=8000

# --- §4 tunables (defaults live in code; uncomment to override) -------------
# IDLE_MINUTES=60
# PASS_INTERVAL_MIN=5
# TICK_MS=60000
# HEARTBEAT_MS=15000
# CMD_TIMEOUT_MS=20000
# EXECUTE_JS_MAX_TIMEOUT_MS=30000  # ceiling on a caller-named per-command budget, for the
                                   # verbs that legitimately wait (async execute_js,
                                   # wait_for, navigate_tab waitUntil). A caller that names
                                   # no timeout still gets CMD_TIMEOUT_MS.
# SNAPSHOT_TIMEOUT_MS=10000
# LEASE_TTL_MS=600000
# RESTORE_EXEMPTION_MIN=120
# MAX_ACTIONS_PER_PASS=20          # the only mass-action brake (§7): a pass whose plan
#                                 # wants more phase-A relocations + closes than this
#                                 # defers them behind ONE confirming click (the plan is
#                                 # shown on the startpage and refreshed every pass).
#                                 # Phase-B completions of already-approved relocations
#                                 # are not counted and still run.
# INCOMPLETE_AFTER_MIN=15
# SELF_NAV_LIMIT=10
# STATE_FRESH_MS=3000
# QUARANTINE_TTL_MIN=1440
# ACTIONS_RETENTION_DAYS=90
# JS_AUDIT_RETENTION_DAYS=730
# MAIN_INSTANCE_ID=main
# PROTOCOL_VERSION=1
# ENROLL_WINDOW_MIN=10            # enrollment window length in minutes (§6). Compared
#                                 # against "now" at read time (no timer), so a restart
#                                 # neither closes an armed window early nor keeps it open.
#                                 # This window IS the permission to enrol: a browser that
#                                 # submits the window code while it is open joins the
#                                 # fleet immediately, under the name set in its extension.
#                                 # There is no approval step, so keep it short and close
#                                 # it when you are done (DELETE /admin/enroll/window).
#   REMOVED: ENROLL_MAX_PENDING and ENROLL_REQUEST_TTL_MIN are gone (they bounded a list of
#   pending requests that no longer exists). Leaving them in a .env is harmless — unknown
#   variables are ignored — but they do nothing.
# ENROLL_PREAUTH_MAX=128          # ceiling on accepted /ext sockets that have not yet
#                                 # said hello/enroll (§6). The Nth pre-auth socket is
#                                 # refused BEFORE accept() (a handshake rejection, no TLS
#                                 # session). A successful hello releases its slot, so this
#                                 # bounds only the pre-auth window, not the live fleet.
