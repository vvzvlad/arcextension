# --- Required tokens (no default in code) -----------------------------------
# EXT_TOKEN opens /ext, /api/* and /mcp; METRICS_TOKEN is read-only for /metrics.
# Both are required, empty = startup failure (§4). Fill them in.
# They must DIFFER (§12): the metrics token lives in a plaintext scrape config in git,
# so reusing EXT_TOKEN there would publish access to /ext, /api/* and /mcp. Equal
# values = startup failure.
#   UPGRADE NOTE: this check is new. An existing install that set both variables to the
#   SAME string will not start after the upgrade — it will print
#   "METRICS_TOKEN: ... must differ from EXT_TOKEN" and exit. Fix before deploying:
#   generate a new METRICS_TOKEN and update the scrape config that uses it.
EXT_TOKEN=
METRICS_TOKEN=
# ADMIN_TOKEN opens /admin (the enrollment console, §13). Required, empty = startup
# failure. It must DIFFER from METRICS_TOKEN (§12): the metrics token lives in a
# plaintext scrape config in git, so reusing it here would publish access to /admin
# (enrollment approvals, revocation). Equal values = startup failure.
ADMIN_TOKEN=
# ADMIN_SESSION_TTL_MIN=720       # lifetime of an /admin HTML-console login session (§13,
#                                 # #36). The cookie holds a random id, never ADMIN_TOKEN;
#                                 # validity is checked server-side in an in-memory store and
#                                 # a rotated ADMIN_TOKEN kills all sessions. 720 = 12h.

# --- Logging / infra --------------------------------------------------------
LOG_LEVEL=INFO
# DB_PATH=data/curator.db
# BACKUP_DIR=data/backups          # dev default (under data/). In prod set an
#                                  # ABSOLUTE path on its OWN volume, e.g.
#                                  # BACKUP_DIR=/app/backups (see docker-compose.yml):
#                                  # backup copies must NOT share the DB volume (§12).
# HOST=0.0.0.0
# PORT=8000
# RESTORE_MARKER_PATH=             # EXTERNAL restore-from-backup marker (§7). EMPTY =
#                                  # detection off. "Off" is itself a RECORDED state, not
#                                  # the absence of one: staying off forever costs
#                                  # nothing, but TURNING DETECTION ON OR OFF LATER is a
#                                  # continuity break like any other config change — see
#                                  # the CONFIG CHANGE note at the end of this block.
#                                  # A DB restored from backup carries the backup's own
#                                  # db_uuid, so restore can only be detected from
#                                  # OUTSIDE the DB. Point this at a small file on a
#                                  # volume that is NOT part of the DB backup — the
#                                  # shipped docker-compose.yml mounts exactly that:
#                                  #   RESTORE_MARKER_PATH=/app/restore/continuity-marker
#                                  # (NOT under /app/data: that volume is "all mutable
#                                  # state" and travels with the restore, which is the
#                                  # very confusion the marker exists to catch.)
#                                  # Write a FRESH uuid into it once at install AND after
#                                  # every restore, BEFORE `docker compose up -d`:
#                                  #   uuidgen > "$RESTORE_MARKER_PATH"
#                                  # A changed marker = continuity break => the first
#                                  # pass is dry_run and waits for a confirming click.
#                                  # Restore procedure: deploy/DEPLOY.md.
#                                  # UPGRADE NOTE: the shipped compose file now sets this
#                                  # unconditionally. Upgrading an EXISTING install does
#                                  # NOT cause a false break — a fingerprint written
#                                  # before this release carries no marker component, so
#                                  # the first pass skips that comparison and records the
#                                  # digest; from the next pass on it is compared. The
#                                  # cost is one blind pass: a restore performed between
#                                  # the upgrade and that first pass is not caught BY THE
#                                  # MARKER (the other fingerprint components still are).
#                                  # CONFIG CHANGE NOTE: switching detection ON (empty ->
#                                  # a path) or OFF (a path -> empty) on an install that
#                                  # has already run a pass under this release is a
#                                  # continuity break, EXPECTED and one-off: the next pass
#                                  # is a dry_run, the plan is shown, one click resumes
#                                  # normal operation. This is deliberate — the fingerprint
#                                  # treats its config inputs alike (IDLE_MINUTES and
#                                  # MAIN_INSTANCE_ID behave the same, §7), and a SILENT
#                                  # switch-off would drop restore detection with no signal
#                                  # at all. Plan the toggle for a maintenance window.
#                                  # WHAT COUNTS AS A BREAK: a CHANGE of state, in either
#                                  # direction — content rewritten, a file that was there
#                                  # disappearing, or a file APPEARING over a recorded
#                                  # "absent". A file that stays absent pass after pass is
#                                  # NOT a break (it is the same state as last time), and
#                                  # a read that FAILS (volume not mounted yet, wrong
#                                  # permissions) is never a break — it is treated as "no
#                                  # information", the stored digest is kept, and
#                                  # /metrics reports curator_restore_marker_unreadable=1
#                                  # so a permanently blind detector is visible. If that
#                                  # gauge is 1, restore detection is OFF: check that the
#                                  # file is readable by uid 1000 (the container user).

# --- §4 tunables (defaults live in code; uncomment to override) -------------
# IDLE_MINUTES=60
# PASS_INTERVAL_MIN=5
# TICK_MS=60000
# HEARTBEAT_MS=15000
# CMD_TIMEOUT_MS=20000
# SNAPSHOT_TIMEOUT_MS=10000
# LEASE_TTL_MS=600000
# RESTORE_EXEMPTION_MIN=120
# PAUSE_DEFAULT_MIN=60
# INCOMPLETE_AFTER_MIN=15
# SELF_NAV_LIMIT=10
# STATE_FRESH_MS=3000
# QUARANTINE_TTL_MIN=1440
# ACTIONS_RETENTION_DAYS=90
# JS_AUDIT_RETENTION_DAYS=730
# MAIN_INSTANCE_ID=main
# PROTOCOL_VERSION=1
# ENROLL_WINDOW_MIN=10            # enrollment window length in minutes (§13). Compared
#                                 # against "now" at read time (no timer), so a restart
#                                 # neither closes an armed window early nor keeps it open.
# ENROLL_MAX_PENDING=64           # ceiling on PENDING enroll_requests (§2). An
#                                 # enroll_request is refused with reason=capacity once
#                                 # the pending list is this large, bounding the
#                                 # operator-facing list against an anon flood.
# ENROLL_REQUEST_TTL_MIN=60       # lifetime of a PENDING enroll_request (§13). Filtered
#                                 # out of GET /admin/enroll/requests once first_seen_at is
#                                 # older than this, then physically swept within ~60s.
#                                 # Must exceed ENROLL_WINDOW_MIN so an operator always has
#                                 # a live request to approve; bounded so a stale/abandoned
#                                 # request self-clears instead of lingering forever.
# ENROLL_PREAUTH_MAX=128          # ceiling on accepted /ext sockets that have not yet
#                                 # said hello/enroll (§2). The Nth pre-auth socket is
#                                 # refused BEFORE accept() (a handshake rejection, no TLS
#                                 # session). A successful hello releases its slot, so this
#                                 # bounds only the pre-auth window, not the live fleet.
# EXT_ALLOWED_ORIGINS=            # comma-separated chrome-extension://<id> allow-list.
#                                 # Used by BOTH the /ext hello check AND /api/* CORS.
#                                 # PROD MUST set this to the real extension id(s):
#                                 #   - /ext: empty = accept any origin (open) + warn;
#                                 #   - /api/*: empty = cross-origin CORS CLOSED (never
#                                 #     '*') + warn. A list that mismatches the real id
#                                 #     is a SILENT failure (WS connects, startpage
#                                 #     shows stale cache) — see deploy/DEPLOY.md (§12).
