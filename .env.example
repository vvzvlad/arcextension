# Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Your own neighbouring service — no default in code, so the address is required
# here (and as `environment:` on prod).
# MY_BACKEND_URL=http://localhost:8000

# Public external service — the default lives in code, overriding is optional.
# GOOGLE_API_URL=https://www.googleapis.com

LOG_LEVEL=INFO
